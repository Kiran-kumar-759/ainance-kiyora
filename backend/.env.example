# Environment Configuration
ENVIRONMENT=development
DEBUG=true
APP_NAME="AI Personal Finance Manager"
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# PostgreSQL Connection (SQLAlchemy with psycopg3)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/pfm_dev
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/pfm_test

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Security & CORS (comma-separated or JSON list of origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Background Processing (Planned Celery / Valkey - documented for Phase 0)
REDIS_URL=redis://127.0.0.1:6379/0
