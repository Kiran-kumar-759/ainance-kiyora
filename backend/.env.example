# Environment Configuration
ENVIRONMENT=development
DEBUG=true
APP_NAME="AI Personal Finance Manager"
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# PostgreSQL Connection (SQLAlchemy with psycopg3)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/pfm_dev
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/pfm_test

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Security & CORS (comma-separated or JSON list of origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Background Processing (Planned Celery / Valkey - documented for Phase 0)
REDIS_URL=redis://127.0.0.1:6379/0

# Bills, Reminders & Optional SMS Provider (Phase 5)
BILL_DUE_SOON_DAYS=5
BILL_STORAGE_DIR=uploads/bills
BILL_MAX_DOC_SIZE_BYTES=10485760
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_INTERVAL_SECONDS=60
REMINDER_DEFAULT_HOUR_IST=9
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMS_ENABLED=false
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=
SMS_WEBHOOK_URL=

# Document Storage, Local OCR & Gmail/SMS Ingestion (Phase 7)
DOCUMENT_STORAGE_DIR=uploads/documents
DOCUMENT_MAX_FILE_SIZE_BYTES=15728640
DOCUMENT_MAX_PDF_PAGES=20
OCR_ENGINE=rapidocr
OCR_USE_ANGLE_CLS=true
OCR_WORKER_ENABLED=true
OCR_WORKER_INTERVAL_SECONDS=15
OCR_WORKER_MAX_CONCURRENT=2
OCR_JOB_MAX_ATTEMPTS=3
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/email/gmail/callback
EMAIL_TOKEN_ENCRYPTION_KEY=
EMAIL_SYNC_MAX_MESSAGES=25
SMS_INGESTION_ENABLED=false
SMS_INGESTION_PROVIDER=none

# AI Expense Intelligence & Optional Groq Provider (Phase 8)
AI_WORKER_ENABLED=true
AI_WORKER_INTERVAL_SECONDS=20
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=12.0
GROQ_MAX_RETRIES=2

# External Services Register (Future Phase 10+)
TAVILY_API_KEY=

