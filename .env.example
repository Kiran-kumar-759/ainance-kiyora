# Root environment configuration template
# Copy to .env or configure respective backend/.env and frontend/.env

# General
ENVIRONMENT=development
APP_NAME="AI Personal Finance Manager"

# Database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/pfm_dev
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/pfm_test

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_TITLE="AI Personal Finance Manager"

# Bills & Notification Channels (Phase 5 - optional external providers)
SMTP_ENABLED=false
SMS_ENABLED=false
SMS_PROVIDER=none

# Document Storage, Local OCR & Gmail/SMS Ingestion (Phase 7)
DOCUMENT_STORAGE_DIR=uploads/documents
OCR_ENGINE=rapidocr
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/email/gmail/callback
EMAIL_TOKEN_ENCRYPTION_KEY=
SMS_INGESTION_ENABLED=false
SMS_INGESTION_PROVIDER=none

# AI Expense Intelligence & Optional Groq Provider (Phase 8)
AI_WORKER_ENABLED=true
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=12.0
GROQ_MAX_RETRIES=2

# Web Research Providers & AI Assistant (Phase 10)
LANGSEARCH_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
DEFAULT_WEB_RESEARCH_PROVIDER=tavily

