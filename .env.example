# Root environment configuration template
# Copy to .env or configure respective backend/.env and frontend/.env

# General
ENVIRONMENT=development
APP_NAME="AI Personal Finance Manager"

# Database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/pfm_dev
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/pfm_test

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_TITLE="AI Personal Finance Manager"

# Bills & Notification Channels (Phase 5 - optional external providers)
SMTP_ENABLED=false
SMS_ENABLED=false
SMS_PROVIDER=none

# Future External Services (Phase 7, 8, 10 - not required in Phase 0)
GROQ_API_KEY=
TAVILY_API_KEY=

